{
  "name": "@ilmek/skills",
  "version": "0.1.1",
  "description": "Agent Skills for ilmek — load SKILL.md folders, expose them to a model with progressive disclosure, and drop them into a graph as data.",
  "type": "module",
  "license": "MIT",
  "author": "AimTune",
  "homepage": "https://github.com/AimTune/ilmek/tree/main/ts/packages/skills#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AimTune/ilmek.git",
    "directory": "ts/packages/skills"
  },
  "bugs": "https://github.com/AimTune/ilmek/issues",
  "keywords": [
    "ilmek",
    "agent",
    "skills",
    "agent-skills",
    "SKILL.md",
    "llm"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@ilmek/core": "workspace:*"
  }
}
