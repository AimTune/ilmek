{
  "name": "@ilmek/mcp",
  "version": "0.2.0",
  "description": "MCP for ilmek — consume Model Context Protocol servers as replay-safe tools, resources and prompt-derived skills, and drop them into a graph as data.",
  "type": "module",
  "license": "MIT",
  "author": "AimTune",
  "homepage": "https://github.com/AimTune/ilmek/tree/main/ts/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AimTune/ilmek.git",
    "directory": "ts/packages/mcp"
  },
  "bugs": "https://github.com/AimTune/ilmek/issues",
  "keywords": [
    "ilmek",
    "agent",
    "mcp",
    "model-context-protocol",
    "tools",
    "llm"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** test/*.test.ts"
  },
  "dependencies": {
    "@ilmek/core": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
